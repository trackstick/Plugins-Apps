{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SecurityRedact.dll",
            "type": "shell",
            "command": "cmd.exe",
            "args": ["/c", "${workspaceFolder}\\build.bat"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "source": "gcc",
                "fileLocation": ["absolute"],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
